# Copy to .env and fill in. Never commit .env.

# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# --- Search (Graph 1) ---
TAVILY_API_KEY=

# --- Notifications: console | webhook | email ---
NOTIFIER=console
WEBHOOK_URL=

# Email via Resend (preferred) or SMTP
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# --- Storage & monitoring ---
# DATA_DIR: folder of the old v1 SQLite watchlist, used only to import v1 data.
DATA_DIR=./data
CHECK_INTERVAL_HOURS=6
DEFAULT_TARGET_DISCOUNT=0.10
DEFAULT_CURRENCY=CAD

# --- PostgreSQL ---
# App data and saved conversations. Use the dedicated app login (see README → Database).
DATABASE_URL=postgresql://shopping_assistant:YOUR_PASSWORD@localhost:5432/shopping_assistant
# Tests empty this database's tables; its name must end in _test.
TEST_DATABASE_URL=postgresql://shopping_assistant:YOUR_PASSWORD@localhost:5432/shopping_assistant_test

# --- HTTP API (web app backend) ---
# The API listens on 127.0.0.1 only. WEB_ORIGINS: comma-separated browser origins allowed to call it.
API_PORT=8000
WEB_ORIGINS=http://localhost:3000
