# Copy to .env and fill in. Never commit .env.

# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# --- Search (Graph 1) ---
TAVILY_API_KEY=

# --- Notifications: console | webhook | email ---
NOTIFIER=console
WEBHOOK_URL=

# Email via Resend (preferred) or SMTP
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# --- Storage & monitoring ---
DATA_DIR=./data
CHECK_INTERVAL_HOURS=6
DEFAULT_TARGET_DISCOUNT=0.10
DEFAULT_CURRENCY=CAD
